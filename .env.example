# Copy to .env. Every key below is optional: each job source switches on by itself once its key is present.

# JSearch: Google for Jobs (aggregates LinkedIn, Naukri, Wellfound, Instahyre, Foundit, company sites)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  · free Basic plan: 200 requests/month
JSEARCH_API_KEY=

# Adzuna: free developer account  · https://developer.adzuna.com/signup  (searches India only today)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: free API key by request  · https://jooble.org/api/about
JOOBLE_API_KEY=

# Advanced, normally left unset:
# NTFY_TOPIC=            # phone-alert topic; one is generated and stored on first use
# DESK_PORT=4321
# CLAUDE_BIN=            # path to the Claude Code CLI if it is not on PATH
# CODEX_BIN=             # path to the Codex CLI if it is not on PATH
# PYTHON_BIN=            # Python 3.10+ for JobSpy if .venv is not used
